SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=<anon-or-service-role-key>
SUPABASE_ACCESS_TOKEN=<personal-access-token>  # supabase.com/dashboard/account/tokens

# Modo de remediación. Por defecto `dry-run`: el EDR razona, decide y valida,
# pero NO envía ninguna señal. Ponlo en `autonomous` para que actúe de verdad.
EDR_MODE=dry-run

# Salvaguardas (opcionales; estos son los valores por defecto).
# EDR_PROTECTED_COMMS=systemd,init,kthreadd,sshd,dockerd,containerd,dbus-daemon,agetty,login
# EDR_RATE_LIMIT_MAX=3
# EDR_RATE_LIMIT_WINDOW=300
# EDR_EVENT_CAP=2000
